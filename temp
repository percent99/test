-- 3) 공통 유틸: updated_at 자동 갱신, 감사 트리거, 부호 강제
CREATE OR REPLACE FUNCTION common.touch_updated_at()
RETURNS trigger LANGUAGE plpgsql AS $$
BEGIN
  IF TG_OP IN ('UPDATE') THEN
    NEW.updated_at := now();
  END IF;
  RETURN NEW;
END$$;
COMMENT ON FUNCTION common.touch_updated_at IS 'UPDATE 시 updated_at=now() 자동 갱신';

CREATE TABLE IF NOT EXISTS audit.log (
  id            uuid PRIMARY KEY DEFAULT public.uuid_v7(),
  table_schema  text NOT NULL,
  table_name    text NOT NULL,
  op            text NOT NULL,                   -- INSERT/UPDATE/DELETE
  pk            jsonb,                           -- 관례상 id(primary key) 추출(가능 시)
  old_data      jsonb,
  new_data      jsonb,
  actor         text,                            -- DB user or app user
  occurred_at   timestamptz NOT NULL DEFAULT now()
);
COMMENT ON TABLE audit.log IS '데이터 변경 감사 로그(append-only)';

CREATE OR REPLACE FUNCTION audit.log_changes()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
  v_actor text;
  v_pk    jsonb;
BEGIN
  -- 앱이 세션에 넣어준 사용자(없으면 DB 사용자)
  v_actor := current_setting('app.user_id', true);
  IF v_actor IS NULL THEN
    v_actor := session_user;
  END IF;

  -- 가능한 경우 id(primary key) 추정
  IF TG_OP = 'DELETE' THEN
    IF to_jsonb(OLD) ? 'id' THEN v_pk := jsonb_build_object('id', (to_jsonb(OLD)->>'id')); END IF;
    INSERT INTO audit.log(table_schema, table_name, op, pk, old_data, actor)
    VALUES (TG_TABLE_SCHEMA, TG_TABLE_NAME, TG_OP, v_pk, to_jsonb(OLD), v_actor);
    RETURN OLD;
  ELSIF TG_OP = 'UPDATE' THEN
    IF to_jsonb(NEW) ? 'id' THEN v_pk := jsonb_build_object('id', (to_jsonb(NEW)->>'id')); END IF;
    INSERT INTO audit.log(table_schema, table_name, op, pk, old_data, new_data, actor)
    VALUES (TG_TABLE_SCHEMA, TG_TABLE_NAME, TG_OP, v_pk, to_jsonb(OLD), to_jsonb(NEW), v_actor);
    RETURN NEW;
  ELSE -- INSERT
    IF to_jsonb(NEW) ? 'id' THEN v_pk := jsonb_build_object('id', (to_jsonb(NEW)->>'id')); END IF;
    INSERT INTO audit.log(table_schema, table_name, op, pk, new_data, actor)
    VALUES (TG_TABLE_SCHEMA, TG_TABLE_NAME, TG_OP, v_pk, to_jsonb(NEW), v_actor);
    RETURN NEW;
  END IF;
END$$;
COMMENT ON FUNCTION audit.log_changes IS 'INSERT/UPDATE/DELETE 공통 감사 트리거';

-- 포인트 금액 부호를 코드 메타(attr.sign)와 일치시키는 트리거
CREATE OR REPLACE FUNCTION core.enforce_point_sign()
RETURNS trigger LANGUAGE plpgsql AS $$
DECLARE
  v_sign int;
BEGIN
  SELECT (ci.attr->>'sign')::int INTO v_sign
  FROM common.code_item ci
  WHERE ci.group_code = NEW.reason_group
    AND ci.code       = NEW.reason_code
    AND ci.is_active
  LIMIT 1;

  IF v_sign IS NULL THEN
    RAISE EXCEPTION 'Unknown or inactive reason (%:%)', NEW.reason_group, NEW.reason_code;
  END IF;

  IF (NEW.amount > 0 AND v_sign = -1) OR (NEW.amount < 0 AND v_sign = 1) THEN
    NEW.amount := NEW.amount * v_sign; -- 부호 보정
  END IF;

  RETURN NEW;
END$$;
COMMENT ON FUNCTION core.enforce_point_sign IS 'point_ledger.amount 부호를 코드 메타(sign)와 일치시킴';

-- 4) COMMON: 사용자/코드(마스터·디테일)
CREATE TABLE IF NOT EXISTS common.user_account (
  id            uuid PRIMARY KEY DEFAULT public.uuid_v7(),
  email         text UNIQUE NOT NULL,
  display_name  text NOT NULL,
  status        text NOT NULL DEFAULT 'active',  -- active|blocked|deleted 등 (코드화 가능)
  created_at    timestamptz NOT NULL DEFAULT now(),
  created_by    text,
  updated_at    timestamptz NOT NULL DEFAULT now(),
  updated_by    text
);
COMMENT ON TABLE common.user_account IS '사용자 계정';

CREATE TABLE IF NOT EXISTS common.code_group (
  group_code   text PRIMARY KEY,                   -- 예: MISSION_TYPE, POINT_REASON, LIB_CLASS
  group_name   text NOT NULL,
  description  text,
  is_active    boolean NOT NULL DEFAULT true,
  created_at   timestamptz NOT NULL DEFAULT now(),
  created_by   text,
  updated_at   timestamptz NOT NULL DEFAULT now(),
  updated_by   text
);
COMMENT ON TABLE common.code_group IS '코드 그룹(대분류) 마스터';
COMMENT ON COLUMN common.code_group.group_code IS '대문자_스네이크 권장';

CREATE TABLE IF NOT EXISTS common.code_item (
  group_code     text NOT NULL REFERENCES common.code_group(group_code) ON UPDATE CASCADE ON DELETE RESTRICT,
  code           text NOT NULL,
  name           text NOT NULL,
  name_short     text,
  sort_order     int  NOT NULL DEFAULT 0,
  is_active      boolean NOT NULL DEFAULT true,
  effective_from date,
  effective_to   date,
  attr           jsonb NOT NULL DEFAULT '{}'::jsonb,  -- 확장 메타(예: {"sign":1})
  created_at     timestamptz NOT NULL DEFAULT now(),
  created_by     text,
  updated_at     timestamptz NOT NULL DEFAULT now(),
  updated_by     text,
  PRIMARY KEY (group_code, code)
);
COMMENT ON TABLE common.code_item IS '코드 상세(복합 PK: group_code+code)';

CREATE INDEX IF NOT EXISTS idx_code_item_active
  ON common.code_item (group_code, is_active, sort_order);

CREATE OR REPLACE VIEW common.code_v AS
SELECT ci.*
FROM common.code_item ci
JOIN common.code_group cg ON cg.group_code = ci.group_code
WHERE cg.is_active
  AND ci.is_active
  AND (ci.effective_from IS NULL OR ci.effective_from <= CURRENT_DATE)
  AND (ci.effective_to   IS NULL OR ci.effective_to   >= CURRENT_DATE);
COMMENT ON VIEW common.code_v IS '활성/유효기간 통과 코드 뷰';

