-- 5) CORE: 미션 / 포인트 / 도서관
-- 5-1) 미션
CREATE TABLE IF NOT EXISTS core.mission_template (
  id            uuid PRIMARY KEY DEFAULT public.uuid_v7(),
  title         text NOT NULL,
  type_group    text NOT NULL DEFAULT 'MISSION_TYPE',
  type_code     text NOT NULL,
  reward_point  int  NOT NULL CHECK (reward_point >= 0),
  is_active     boolean NOT NULL DEFAULT true,
  created_at    timestamptz NOT NULL DEFAULT now(),
  created_by    text,
  updated_at    timestamptz NOT NULL DEFAULT now(),
  updated_by    text,
  CONSTRAINT fk_mission_type
    FOREIGN KEY (type_group, type_code)
    REFERENCES common.code_item(group_code, code)
);
COMMENT ON TABLE core.mission_template IS '미션 템플릿(유형/보상 포인트 포함)';

CREATE TABLE IF NOT EXISTS core.mission_assignment (
  id            uuid PRIMARY KEY DEFAULT public.uuid_v7(),
  template_id   uuid NOT NULL REFERENCES core.mission_template(id),
  assignee_id   uuid NOT NULL REFERENCES common.user_account(id),
  due_date      date,
  status_group  text NOT NULL DEFAULT 'MISSION_STATUS',
  status_code   text NOT NULL DEFAULT 'ASSIGNED',      -- ASSIGNED|DONE|VERIFIED|CANCELED 등
  created_at    timestamptz NOT NULL DEFAULT now(),
  created_by    text,
  updated_at    timestamptz NOT NULL DEFAULT now(),
  updated_by    text,
  CONSTRAINT fk_mission_status
    FOREIGN KEY (status_group, status_code)
    REFERENCES common.code_item(group_code, code)
);
COMMENT ON TABLE core.mission_assignment IS '미션 할당';

CREATE INDEX IF NOT EXISTS idx_mission_assignment_assignee_status
  ON core.mission_assignment (assignee_id, status_code);

-- 5-2) 포인트
CREATE TABLE IF NOT EXISTS core.point_ledger (
  id            uuid PRIMARY KEY DEFAULT public.uuid_v7(),
  user_id       uuid NOT NULL REFERENCES common.user_account(id),
  reason_group  text NOT NULL DEFAULT 'POINT_REASON',
  reason_code   text NOT NULL,                           -- MISSION_OK|REDEEM 등
  amount        int  NOT NULL,                           -- +적립/-차감 (트리거로 부호 보정)
  ref_id        uuid,                                    -- 관련 객체(예: assignment id)
  occurred_at   timestamptz NOT NULL DEFAULT now(),
  created_at    timestamptz NOT NULL DEFAULT now(),
  created_by    text,
  CONSTRAINT fk_point_reason
    FOREIGN KEY (reason_group, reason_code)
    REFERENCES common.code_item(group_code, code)
);
COMMENT ON TABLE core.point_ledger IS '포인트 원장(적립/차감 트랜잭션)';

CREATE INDEX IF NOT EXISTS idx_point_ledger_user_time
  ON core.point_ledger (user_id, occurred_at DESC);

-- 부호 강제 + updated_at 갱신(ledger엔 updated_at이 없으므로 생략)
CREATE TRIGGER t_point_ledger_enforce_sign
BEFORE INSERT OR UPDATE ON core.point_ledger
FOR EACH ROW EXECUTE FUNCTION core.enforce_point_sign();

-- 5-3) 도서관
CREATE TABLE IF NOT EXISTS core.lib_book (
  id            uuid PRIMARY KEY DEFAULT public.uuid_v7(),
  isbn          text,
  title         text NOT NULL,
  author        text,
  class_group   text NOT NULL DEFAULT 'LIB_CLASS',
  class_code    text REFERENCES common.code_item(code),  -- 복합 FK를 위해 컬럼 분리
  created_at    timestamptz NOT NULL DEFAULT now(),
  created_by    text,
  updated_at    timestamptz NOT NULL DEFAULT now(),
  updated_by    text,
  CONSTRAINT fk_lib_class
    FOREIGN KEY (class_group, class_code)
    REFERENCES common.code_item(group_code, code)
);
COMMENT ON TABLE core.lib_book IS '도서(서지)';

CREATE TABLE IF NOT EXISTS core.lib_copy (
  id            uuid PRIMARY KEY DEFAULT public.uuid_v7(),
  book_id       uuid NOT NULL REFERENCES core.lib_book(id),
  barcode       text UNIQUE,
  status_group  text NOT NULL DEFAULT 'LIB_COPY_STATUS',
  status_code   text NOT NULL DEFAULT 'AVAILABLE',      -- AVAILABLE|LOANED|LOST|REPAIR
  created_at    timestamptz NOT NULL DEFAULT now(),
  created_by    text,
  updated_at    timestamptz NOT NULL DEFAULT now(),
  updated_by    text,
  CONSTRAINT fk_lib_copy_status
    FOREIGN KEY (status_group, status_code)
    REFERENCES common.code_item(group_code, code)
);
COMMENT ON TABLE core.lib_copy IS '소장본(실물)';

CREATE TABLE IF NOT EXISTS core.lib_loan (
  id            uuid PRIMARY KEY DEFAULT public.uuid_v7(),
  copy_id       uuid NOT NULL REFERENCES core.lib_copy(id),
  user_id       uuid NOT NULL REFERENCES common.user_account(id),
  loaned_at     timestamptz NOT NULL DEFAULT now(),
  due_at        timestamptz,
  returned_at   timestamptz,
  created_at    timestamptz NOT NULL DEFAULT now(),
  created_by    text,
  updated_at    timestamptz NOT NULL DEFAULT now(),
  updated_by    text
);
COMMENT ON TABLE core.lib_loan IS '대출 이력(반납일 null=대출중)';

