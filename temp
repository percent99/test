-- 6) RLS (Row-Level Security)
-- 앱에서 SET LOCAL app.user_id='...'; 로 세션에 주입했다고 가정
-- 백오피스는 별도 역할로 RLS를 우회(정책을 넓게 주거나, 아예 BYPASS ROLE 사용)
ALTER TABLE core.mission_assignment ENABLE ROW LEVEL SECURITY;
ALTER TABLE core.point_ledger      ENABLE ROW LEVEL SECURITY;
ALTER TABLE core.lib_loan          ENABLE ROW LEVEL SECURITY;

-- 기본 거부
CREATE POLICY rls_mission_assignment_none ON core.mission_assignment
  AS RESTRICTIVE FOR ALL
  TO PUBLIC
  USING (false) WITH CHECK (false);

CREATE POLICY rls_point_ledger_none ON core.point_ledger
  AS RESTRICTIVE FOR ALL
  TO PUBLIC
  USING (false) WITH CHECK (false);

CREATE POLICY rls_lib_loan_none ON core.lib_loan
  AS RESTRICTIVE FOR ALL
  TO PUBLIC
  USING (false) WITH CHECK (false);

-- role_api_rw: 자신의 데이터만
CREATE POLICY rls_mission_assignment_self ON core.mission_assignment
  FOR SELECT USING (assignee_id::text = current_setting('app.user_id', true))
  TO role_api_rw;
CREATE POLICY rls_mission_assignment_self_ins ON core.mission_assignment
  FOR INSERT WITH CHECK (assignee_id::text = current_setting('app.user_id', true))
  TO role_api_rw;
CREATE POLICY rls_mission_assignment_self_upd ON core.mission_assignment
  FOR UPDATE USING (assignee_id::text = current_setting('app.user_id', true))
             WITH CHECK (assignee_id::text = current_setting('app.user_id', true))
  TO role_api_rw;

CREATE POLICY rls_point_ledger_self ON core.point_ledger
  FOR SELECT USING (user_id::text = current_setting('app.user_id', true))
  TO role_api_rw;
CREATE POLICY rls_point_ledger_self_ins ON core.point_ledger
  FOR INSERT WITH CHECK (user_id::text = current_setting('app.user_id', true))
  TO role_api_rw;

CREATE POLICY rls_lib_loan_self ON core.lib_loan
  FOR SELECT USING (user_id::text = current_setting('app.user_id', true))
  TO role_api_rw;
CREATE POLICY rls_lib_loan_self_ins ON core.lib_loan
  FOR INSERT WITH CHECK (user_id::text = current_setting('app.user_id', true))
  TO role_api_rw;

-- role_backoffice_rw: 넓은 접근(여기서는 전체 허용)
CREATE POLICY rls_mission_assignment_bo ON core.mission_assignment
  FOR ALL TO role_backoffice_rw
  USING (true) WITH CHECK (true);

CREATE POLICY rls_point_ledger_bo ON core.point_ledger
  FOR ALL TO role_backoffice_rw
  USING (true) WITH CHECK (true);

CREATE POLICY rls_lib_loan_bo ON core.lib_loan
  FOR ALL TO role_backoffice_rw
