CREATE TABLE mis.mission_templates (
  id              UUID PRIMARY KEY DEFAULT core.UUID_V7(),         -- 템플릿 PK
  household_id    UUID NOT NULL REFERENCES usr.households(id) ON DELETE CASCADE,
  title           TEXT NOT NULL,                                    -- 템플릿 제목
  description     TEXT,                                             -- 설명
  default_points  INT  NOT NULL CHECK (default_points >= 0),        -- 기본 포인트
  repeat_rule     TEXT,                                             -- RRULE 등 (예: FREQ=DAILY)
  active          BOOLEAN NOT NULL DEFAULT TRUE,                    -- 사용여부
  created_by      UUID,
  created_at      TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_by      UUID,
  updated_at      TIMESTAMPTZ NOT NULL DEFAULT now()
);
COMMENT ON TABLE mis.mission_templates IS '미션 템플릿(반복 규칙 포함)';

CREATE INDEX idx_mtpl_household_active ON mis.mission_templates(household_id, active);

