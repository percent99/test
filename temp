    REFERENCES core.code_details(master_code, code)
    ON UPDATE RESTRICT ON DELETE RESTRICT,
  source_id     UUID,                                               -- mis.missions.id / pt.redemptions.id 등
  amount        INT  NOT NULL CHECK (amount <> 0),                  -- 적립:+ / 차감:-
  description   TEXT,
  created_by    UUID,
  created_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_by    UUID,
  updated_at    TIMESTAMPTZ NOT NULL DEFAULT now()
