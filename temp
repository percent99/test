-- =========================================================================
-- 7) 보상 교환 트랜잭션 함수 (즉시 승인/차감 버전)
--    - 잔액 확인 → 재고 확인/차감 → 교환 레코드 생성(승인) → 원장 차감
--    - 동시성: 재고 UPDATE, 원장 입력을 같은 트랜잭션에서 처리
-- =========================================================================
CREATE OR REPLACE FUNCTION pt.redeem_reward_immediate(p_child UUID, p_reward UUID, p_parent UUID)
RETURNS UUID
LANGUAGE plpgsql
AS $$
DECLARE
  v_household   UUID;
  v_cost        INT;
  v_stock       INT;
  v_balance     INT;
  v_redemption  UUID;
BEGIN
  -- 보상 정보 잠금 (재고 보호)
  SELECT household_id, points_cost, COALESCE(stock, -1)
    INTO v_household, v_cost, v_stock
  FROM pt.rewards
  WHERE id = p_reward AND active = TRUE
  FOR UPDATE;

  IF NOT FOUND THEN
    RAISE EXCEPTION 'Reward not found or inactive';
  END IF;

  -- 잔액 계산 (동시 차감 방지용 공유락 정도)
  SELECT COALESCE(SUM(amount), 0)
    INTO v_balance
  FROM pt.points_ledger
  WHERE child_id = p_child
  FOR SHARE;

  IF v_balance < v_cost THEN
    RAISE EXCEPTION 'Insufficient points: balance %, cost %', v_balance, v_cost;
  END IF;

  -- 재고 차감 (무제한=-1)
  IF v_stock >= 0 THEN
    IF v_stock = 0 THEN
      RAISE EXCEPTION 'Out of stock';
    END IF;

    UPDATE pt.rewards
       SET stock = stock - 1
     WHERE id = p_reward;
  END IF;

  -- 교환 레코드: 즉시 승인/지급 처리(승인자/시각)
  INSERT INTO pt.redemptions (
      id, household_id, child_id, reward_id,
      status_master_code, status_code,
      points_cost_snapshot, approved_by, approved_at, fulfilled_at,
      created_by, created_at, updated_by, updated_at
  )
  VALUES (
      core.UUID_V7(), v_household, p_child, p_reward,
      'redemption_status', 'approved',
      v_cost, p_parent, now(), now(),
      p_parent, now(), p_parent, now()
  )
  RETURNING id INTO v_redemption;

  -- 원장 차감
  INSERT INTO pt.points_ledger (
      id, household_id, child_id,
      source_master_code, source_code, source_id,
      amount, description, created_by, created_at, updated_by, updated_at
  )
  VALUES (
      core.UUID_V7(), v_household, p_child,
      'ledger_source', 'redemption', v_redemption,
      -v_cost, '상품 교환 차감', p_parent, now(), p_parent, now()
  );

  RETURN v_redemption;
END;
$$;
COMMENT ON FUNCTION pt.redeem_reward_immediate(UUID, UUID, UUID)
IS '보상 즉시 교환(승인/차감) 트랜잭션 함수';

-- =========================================================================
-- 8) 리포트/뷰 (util)
-- =========================================================================

CREATE OR REPLACE VIEW util.v_child_points_balance AS
SELECT
  u.id            AS child_id,
  u.display_name,
  u.household_id,
  COALESCE(SUM(l.amount), 0) AS balance
FROM usr.users u
LEFT JOIN pt.points_ledger l ON l.child_id = u.id
WHERE (u.role_master_code, u.role_code) = ('user_role','child')
GROUP BY u.id, u.display_name, u.household_id;
COMMENT ON VIEW util.v_child_points_balance IS '자녀별 포인트 잔액(원장 합계 기반)';

