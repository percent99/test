CREATE TABLE mis.missions (
  id               UUID PRIMARY KEY DEFAULT core.UUID_V7(),         -- 미션 인스턴스 PK
  household_id     UUID NOT NULL REFERENCES usr.households(id) ON DELETE CASCADE,
  template_id      UUID REFERENCES mis.mission_templates(id),       -- 템플릿 출처(선택)
  child_id         UUID NOT NULL REFERENCES usr.users(id) ON DELETE CASCADE,
  title            TEXT NOT NULL,                                   -- 제목(스냅샷/자유입력)
  description      TEXT,                                            -- 설명
  points           INT  NOT NULL CHECK (points >= 0),               -- 적립 포인트
  due_at           TIMESTAMPTZ,                                     -- 마감일시
  status_master_code TEXT GENERATED ALWAYS AS ('mission_status') STORED,
  status_code        TEXT NOT NULL,                                 -- assigned/submitted/...
  CONSTRAINT fk_missions_status
    FOREIGN KEY (status_master_code, status_code)
    REFERENCES core.code_details(master_code, code)
    ON UPDATE RESTRICT ON DELETE RESTRICT,
  submitted_at     TIMESTAMPTZ,                                     -- 자녀 제출 시각
  approved_at      TIMESTAMPTZ,                                     -- 승인 시각
  approved_by      UUID REFERENCES usr.users(id),                    -- 승인자(부모)
  cancelled_at     TIMESTAMPTZ,                                     -- 취소 시각
  created_by       UUID,
  created_at       TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_by       UUID,
  updated_at       TIMESTAMPTZ NOT NULL DEFAULT now(),
  CONSTRAINT approved_needs_timestamp CHECK (
    status_code <> 'approved' OR approved_at IS NOT NULL
  )
);
COMMENT ON TABLE mis.missions IS '자녀에게 할당된 실제 미션(상태/마감 포함)';

