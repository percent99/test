/* =======================================================================
   미션/포인트 관리 v7 스키마 - 완판본 DDL
   - PostgreSQL UUID v7 기반 PK
   - ENUM 대체: 코드 마스터/디테일 (core.code_masters / core.code_details)
   - 스키마 분리: core / usr / mis / pt / util
   - 공통 메타컬럼: created_by, created_at, updated_by, updated_at
   - updated_at 자동 갱신 트리거
   - 교차 스키마 FK 명시
   - 보상 교환 트랜잭션 함수 포함 (pt.redeem_reward_immediate)
   ======================================================================= */

-- (권장) 트랜잭션으로 감싸기
BEGIN;

-- =========================================================================
-- 0) (옵션) 깨끗한 재생성을 위해 드롭
--     운영환경에서는 데이터 보존을 위해 DROP 사용 시 주의하세요.
-- =========================================================================
DROP VIEW IF EXISTS util.v_child_points_balance CASCADE;

DROP SCHEMA IF EXISTS util CASCADE;
DROP SCHEMA IF EXISTS pt   CASCADE;
DROP SCHEMA IF EXISTS mis  CASCADE;
DROP SCHEMA IF EXISTS usr  CASCADE;
DROP SCHEMA IF EXISTS core CASCADE;

-- =========================================================================
-- 1) 스키마 생성
-- =========================================================================
CREATE SCHEMA core;
CREATE SCHEMA usr;
CREATE SCHEMA mis;
CREATE SCHEMA pt;
CREATE SCHEMA util;

-- =========================================================================
-- 2) UUID v7 별칭 함수 및 공용 트리거
--    - PG 18+: uuidv7() 내장 사용
--    - PG 17-: pg_uuidv7 확장 설치 후 uuid_generate_v7() 사용
--    아래 두 중 한가지만 선택하여 UNCOMMENT 하세요.
-- =========================================================================

-- -- [A] PostgreSQL 18 이상
-- CREATE OR REPLACE FUNCTION core.UUID_V7() RETURNS uuid
-- LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $$
--   SELECT uuidv7()
-- $$;

-- -- [B] PostgreSQL 17 이하 (확장 설치 필요: pg_uuidv7)
-- CREATE EXTENSION IF NOT EXISTS pg_uuidv7;
-- CREATE OR REPLACE FUNCTION core.UUID_V7() RETURNS uuid
-- LANGUAGE sql IMMUTABLE PARALLEL SAFE AS $$
--   SELECT uuid_generate_v7()
-- $$;

COMMENT ON FUNCTION core.UUID_V7 IS 'UUID v7 생성 별칭 함수: PG18=uuidv7(), PG17=uuid_generate_v7()';

-- updated_at 자동 갱신 트리거 (updated_by는 앱에서 세팅)
CREATE OR REPLACE FUNCTION core.trg_set_updated_at()
RETURNS trigger
LANGUAGE plpgsql AS $$
BEGIN
  NEW.updated_at := now();
  RETURN NEW;
END $$;
COMMENT ON FUNCTION core.trg_set_updated_at IS '행 UPDATE 시 updated_at을 now()로 자동 갱신';

-- =========================================================================
-- 3) 코드 마스터/디테일 (ENUM 대체)
--    - master_code + code의 자연키로 도메인 무결성 확보
--    - 운영 중 항목追加/비활성/정렬 변경 용이
-- =========================================================================

CREATE TABLE core.code_masters (
  code         TEXT PRIMARY KEY,                         -- 예: 'user_role', 'mission_status'
  name         TEXT NOT NULL,                            -- 화면/리포트용
  description  TEXT,                                     -- 설명
  created_by   UUID,
  created_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_by   UUID,
  updated_at   TIMESTAMPTZ NOT NULL DEFAULT now()
);
COMMENT ON TABLE core.code_masters IS '코드 마스터(ENUM 대체)';

CREATE TRIGGER code_masters_set_updated_at
BEFORE UPDATE ON core.code_masters
FOR EACH ROW EXECUTE FUNCTION core.trg_set_updated_at();

CREATE TABLE core.code_details (
  master_code  TEXT NOT NULL REFERENCES core.code_masters(code) ON DELETE RESTRICT,
  code         TEXT NOT NULL,                            -- 항목 코드 (자연키)
  name         TEXT NOT NULL,                            -- 표시명
  description  TEXT,                                     -- 항목 설명
  sort_order   INT  NOT NULL DEFAULT 0,                  -- 정렬 우선순위
  active       BOOLEAN NOT NULL DEFAULT TRUE,            -- 사용여부
  id           UUID PRIMARY KEY DEFAULT core.UUID_V7(),  -- 서로게이트 키(선택적 활용)
  created_by   UUID,
  created_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
  updated_by   UUID,
  updated_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
  UNIQUE (master_code, code)
);
COMMENT ON TABLE core.code_details IS '코드 디테일(ENUM 항목 대체). (master_code, code) 유니크';

CREATE INDEX idx_code_details_master_active ON core.code_details(master_code, active, sort_order);

CREATE TRIGGER code_details_set_updated_at
BEFORE UPDATE ON core.code_details
FOR EACH ROW EXECUTE FUNCTION core.trg_set_updated_at();

