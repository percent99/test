-- 7) REPORT: 읽기 전용 뷰
CREATE OR REPLACE VIEW report.point_balance AS
SELECT user_id, SUM(amount) AS balance
FROM core.point_ledger
GROUP BY user_id;

CREATE OR REPLACE VIEW report.mission_status_summary AS
SELECT ma.assignee_id,
       ma.status_code,
       COUNT(*) AS cnt
FROM core.mission_assignment ma
GROUP BY ma.assignee_id, ma.status_code;

CREATE OR REPLACE VIEW report.lib_current_loans AS
SELECT l.id AS loan_id, c.id AS copy_id, b.title, l.user_id, l.loaned_at, l.due_at
FROM core.lib_loan l
JOIN core.lib_copy c ON c.id = l.copy_id
JOIN core.lib_book b ON b.id = c.book_id
WHERE l.returned_at IS NULL;

COMMENT ON VIEW report.point_balance IS '사용자별 포인트 잔액(원장 합계)';
COMMENT ON VIEW report.mission_status_summary IS '사용자별 미션 상태 집계';
COMMENT ON VIEW report.lib_current_loans IS '현재 대출중 목록';

