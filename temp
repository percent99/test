-- 0) 확장 및 UUID v7 래퍼
CREATE EXTENSION IF NOT EXISTS pgcrypto;  -- gen_random_uuid()
DO $$
BEGIN
  IF NOT EXISTS (SELECT 1 FROM pg_extension WHERE extname = 'pg_uuidv7') THEN
    RAISE NOTICE 'pg_uuidv7 not installed; fallback to gen_random_uuid()';
    EXECUTE $f$CREATE OR REPLACE FUNCTION public.uuid_v7() RETURNS uuid
             LANGUAGE sql IMMUTABLE PARALLEL SAFE
             AS $$ SELECT gen_random_uuid() $$;$f$;
  ELSE
    EXECUTE $f$CREATE OR REPLACE FUNCTION public.uuid_v7() RETURNS uuid
             LANGUAGE sql IMMUTABLE PARALLEL SAFE
             AS $$ SELECT uuid_generate_v7() $$;$f$;
  END IF;
END$$;

COMMENT ON FUNCTION public.uuid_v7() IS 'UUID v7 (pg_uuidv7 있으면 사용, 없으면 gen_random_uuid() 대체)';

